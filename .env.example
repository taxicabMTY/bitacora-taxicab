# Copia este archivo como `.env` (misma carpeta) y llénalo. NO se sube a git.

# Cuenta de Gmail desde la que sale el correo (la tuya).
GMAIL_USER=

# Contraseña de aplicación de Google (16 caracteres, con o sin espacios).
# Se genera en https://myaccount.google.com/apppasswords (pide verificación en 2 pasos).
GMAIL_APP_PASSWORD=

# A quién le llega el reporte.
DESTINATARIO=
DESTINATARIO_NOMBRE=

# Cómo se firma el correo (tu nombre).
REMITENTE_NOMBRE=

# Opcionales. Si los dejas vacíos se usan estos valores:
#   REPORTES_DIR       Documents/TaxiCab-Notas/Reportes dentro de tu carpeta de usuario
#   ULTIMOS_ENVIOS_LOG .enviados.log junto al script
#   NAVEGADOR          Chrome o Edge, se buscan solos
REPORTES_DIR=
ULTIMOS_ENVIOS_LOG=
NAVEGADOR=
